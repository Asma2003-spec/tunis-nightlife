# Copier ce fichier en .env (racine) et apps/api/.env — ne jamais committer les vrais fichiers .env

# Base de données locale (docker compose)
POSTGRES_USER=tunis
POSTGRES_PASSWORD=tunis_dev_password
POSTGRES_DB=tunis_nightlife
DATABASE_URL=postgresql://tunis:tunis_dev_password@127.0.0.1:5432/tunis_nightlife?schema=public

# API
API_PORT=4000
CORS_ORIGINS=http://localhost:3000
# Secret de signature des sessions (64 caractères aléatoires). Générer avec :
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=

# Web
NEXT_PUBLIC_API_URL=http://localhost:4000/api/v1

# Mobile (Expo) — sur un téléphone physique, remplacer localhost par l'IP locale de l'ordinateur
EXPO_PUBLIC_API_URL=http://localhost:4000/api/v1
